{
  "rewrites": [
    { "source": "/aulaclevel", "destination": "https://altum-presenca.vercel.app/aula" },
    { "source": "/aulaclevel/:path*", "destination": "https://altum-presenca.vercel.app/aula/:path*" },
    { "source": "/conselho", "destination": "https://altum-presenca.vercel.app/conselho" },
    { "source": "/conselho/:path*", "destination": "https://altum-presenca.vercel.app/conselho/:path*" },
    { "source": "/_next/:path*", "destination": "https://altum-presenca.vercel.app/_next/:path*" },
    { "source": "/convidados/:path*", "destination": "https://altum-presenca.vercel.app/convidados/:path*" }
  ],
  "redirects": [
    { "source": "/presenca", "destination": "https://altum-presenca.vercel.app/login", "permanent": false }
  ]
}
